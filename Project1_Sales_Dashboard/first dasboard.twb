    <worksheet name='Cohort heatmap'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>Cohort index&#10;&#10;&#10;&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sample - Superstore' name='federated.1ologhs1x0e6xw189mywu03a8cco' />
          </datasources>
          <datasource-dependencies datasource='federated.1ologhs1x0e6xw189mywu03a8cco'>
            <column caption='First Purchase month 1' datatype='datetime' name='[Calculation_0664121405759488]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [Customer ID]:&#13;&#10;MIN(DATETRUNC(&apos;month&apos;,[Order Date]))}' />
            </column>
            <column caption='Order month1' datatype='datetime' name='[Calculation_0664121406734337]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[Order Date])' />
            </column>
            <column caption='Cohort Index' datatype='integer' name='[Calculation_0664121407291394]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&#13;&#10;&apos;month&apos;,&#13;&#10;[Calculation_0664121405759488],&#13;&#10;[Calculation_0664121406734337]&#13;&#10;)' />
            </column>
            <column datatype='string' name='[Customer ID]' role='dimension' type='nominal' />
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_0664121407291394]' derivation='None' name='[none:Calculation_0664121407291394:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Customer ID]' derivation='None' name='[none:Customer ID:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0664121405759488]' derivation='Year' name='[yr:Calculation_0664121405759488:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
