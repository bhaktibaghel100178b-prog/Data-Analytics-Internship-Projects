      <aliases enabled='yes' />
      <column caption='Profit Margin' datatype='real' name='[Calculation_0642954790215681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/Sum([Sales])*100' />
      </column>
      <column caption='YoY growth' datatype='real' name='[Calculation_0642954794672130]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Sales]) - LOOKUP(SUM([Sales]),-1))&#13;&#10;/&#13;&#10;ABS(LOOKUP(SUM([Sales]),-1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Day of week' datatype='string' name='[Calculation_0642954796859395]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;,[Order Date])' />
      </column>
      <column caption='Customer Lifetime value' datatype='real' name='[Calculation_0642955534053380]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Customer ID]:&#13;&#10;SUM([Sales])}' />
      </column>
      <column caption='First Purchase month' datatype='datetime' name='[Calculation_0642955534532613]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [Customer ID]:&#13;&#10;MIN(DATETRUNC(&apos;month&apos;,[Order Date]))}' />
      </column>
      <column caption='Order month' datatype='datetime' name='[Calculation_0642955534864390]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[Order Date])' />
      </column>
      <column caption='First Purchase month 1' datatype='datetime' name='[Calculation_0664121405759488]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [Customer ID]:&#13;&#10;MIN(DATETRUNC(&apos;month&apos;,[Order Date]))}' />
      </column>
      <column caption='Order month1' datatype='datetime' name='[Calculation_0664121406734337]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[Order Date])' />
      </column>
      <column caption='Cohort Index' datatype='integer' name='[Calculation_0664121407291394]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&#13;&#10;&apos;month&apos;,&#13;&#10;[Calculation_0664121405759488],&#13;&#10;[Calculation_0664121406734337]&#13;&#10;)' />
      </column>
      <column caption='Profit Status' datatype='string' name='[Calculation_0664121421848579]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit]) &gt;= 0 THEN &quot;Profit&quot;&#13;&#10;ELSE &quot;Loss&quot;&#13;&#10;END' />
      </column>
      <column caption='YoY Growth %' datatype='real' name='[Calculation_0664121424609284]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;SUM([Sales]) - LOOKUP(SUM([Sales]), -1)&#13;&#10;)&#13;&#10;/&#13;&#10;LOOKUP(SUM([Sales]), -1)&#13;&#10;* 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='string' name='[Customer ID]' role='dimension' type='nominal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Postal Code]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
      <column datatype='integer' name='[Row ID]' role='dimension' type='ordinal' />
